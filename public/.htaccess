# Configuración para Hostinger (servidor Apache).
# Este archivo se copia a out/ al compilar y se sube junto con la página.

# Página de error cuando una dirección no existe
ErrorDocument 404 /404.html

# Al entrar a una carpeta, mostrar su index.html (y nunca la lista de archivos)
DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Siempre usar https:// (candado de seguridad)
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # www.zentravelmed.com → zentravelmed.com (una sola dirección)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# Guardar en el navegador por más tiempo lo que casi no cambia
<IfModule mod_expires.c>
  ExpiresActive On
  # Archivos de Next.js: su nombre cambia en cada versión, se pueden guardar 1 año
  <FilesMatch "^.*\.(js|css|woff2)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/avif "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 month"
  # Las páginas HTML se revisan siempre, para ver los cambios al instante
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Comprimir textos para que carguen más rápido
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
