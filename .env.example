# Copia este archivo como ".env.local" y llena los valores.
# ".env.local" NO se sube a GitHub (está en .gitignore).
#
# "NEXT_PUBLIC_" significa que el valor se incluye en la página que ve el
# navegador. Está bien para estos dos: la URL y la publishable key son
# públicas por diseño, y la seguridad la ponen las políticas RLS de Supabase.
# OJO: después de cambiar estos valores hay que volver a compilar (npm run build).

# Supabase → Project Settings → Data API → Project URL (termina en .supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase → Project Settings → API Keys → "Publishable key" (empieza por sb_publishable_)
# NUNCA pongas aquí la "secret key".
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
